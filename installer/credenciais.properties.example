# Credenciais de autenticacao contra a API da Ottimizza (OAuth2 password grant).
# Copie este arquivo para "credenciais.properties" (sem ".example") na mesma pasta
# do robo.jar e preencha com os valores reais - NAO versionar o arquivo preenchido.
#
# Alternativa: definir como variaveis de ambiente do processo/servico, com o mesmo
# efeito e prioridade sobre este arquivo:
#   ROBO_AUTH_SERVER_URL, ROBO_AUTH_CLIENT_ID, ROBO_AUTH_CLIENT_SECRET, ROBO_AUTH_SENHA_INTEGRACAO

AUTH_SERVER_URL=https://SUBSTITUIR-PELA-URL-DO-SERVIDOR-DE-AUTENTICACAO
CLIENT_ID=SUBSTITUIR
CLIENT_SECRET=SUBSTITUIR
SENHA_INTEGRACAO=SUBSTITUIR
